<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile arg="true"/>
  <group name="General">
    <!-- Stored as a combo box index, not the semantic string (mic/opus/...)
         directly - see ConfigAudio.qml's comment on why `property alias` to
         currentIndex is what makes the config dialog's Apply button work.
         main.qml's pushConfig() maps the index back to the string scrcpy
         actually expects before sending it to the daemon. -->
    <entry name="audioSource" type="Int">
      <default>0</default>
    </entry>
    <entry name="audioCodec" type="Int">
      <default>0</default>
    </entry>
    <entry name="virtualSinkName" type="String">
      <default>VirtualMicSink</default>
    </entry>
    <entry name="virtualSourceName" type="String">
      <default>VirtualMicSource</default>
    </entry>
    <!-- What apps actually display in their mic picker (node.description,
         not node.name). Empty means "just use the name above". Only takes
         effect on a sink/source this daemon creates itself - there's no way
         to rename an existing node's description (see
         pipewire_route.ensure_virtual_mic's docstring), so this has no
         effect if a sink with that name already exists (e.g. your own
         static pipewire.conf.d loopback). -->
    <entry name="virtualSinkDescription" type="String">
      <default></default>
    </entry>
    <entry name="virtualSourceDescription" type="String">
      <default></default>
    </entry>
    <!-- Off by default - switches the system's default microphone to the
         virtual one while forwarding, and restores whatever it was before
         once forwarding stops. A real side effect (e.g. an unrelated app
         querying the default mid-session), so opt-in like
         autoStartOnKnownDevice below. -->
    <entry name="setAsDefaultSource" type="Bool">
      <default>false</default>
    </entry>
    <entry name="autoStartOnKnownDevice" type="Bool">
      <default>false</default>
    </entry>
    <entry name="probeIntervalSec" type="Int">
      <default>15</default>
    </entry>
    <entry name="maxReconnectAttempts" type="Int">
      <default>5</default>
    </entry>
    <entry name="reconnectBackoffSec" type="String">
      <default>2,5,10,20,40,60</default>
    </entry>
    <entry name="adbPath" type="String">
      <default></default>
    </entry>
    <entry name="scrcpyPath" type="String">
      <default></default>
    </entry>
    <!-- 0 = mute toggle, 1 = disconnect the active wireless device,
         2 = stop/start the backend service. Index order must match
         ConfigAdvanced.qml's combo box and main.qml's
         performQuickAction(). Purely a widget-side UI preference -
         never sent to the daemon via SetConfig. -->
    <entry name="quickAction" type="Int">
      <default>0</default>
    </entry>
    <!-- 0 = rotating arc, 1 = breathing full ring, 2 = double comet. Purely
         cosmetic (CompactView.qml) - never sent to the daemon. -->
    <entry name="connectionAnimationStyle" type="Int">
      <default>0</default>
    </entry>
  </group>
</kcfg>
